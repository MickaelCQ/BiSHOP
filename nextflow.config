/*
========================================================================================
    Pipeline Exome Constitutionnel Clinique - BiSHOP V2
    Config Centralisée sur /mnt/ngs_miseq/BIOINFO/Bioresources
    Laboratoire de Génétique Médicale — CHU de Nîmes
========================================================================================
*/

params {
    // =================================================================================
    // 1. RACINE MAÎTRE DES BIORESSOURCES (Lien unique modifiable pour la migration)
    // =================================================================================
    bioresources      = "/mnt/ngs_miseq/BIOINFO/Bioresources"

    // Références Génomiques (GRCh38 / hg38)
    fasta             = "${params.bioresources}/references/hg38.fa"
    fasta_fai         = "${params.bioresources}/references/hg38.fa.fai"
    dict              = "${params.bioresources}/references/hg38.dict"
    bwa_index         = "${params.bioresources}/references/hg38.fa"

    // BED par défaut (RefSeq CDS Canonique)
    default_bed       = "${params.bioresources}/beds/RefSeq_hg38_CDS_neutral_canonical.bed"

    // Configuration MultiQC & Cache VEP
    multiqc_config    = "${params.bioresources}/configs/multiqc_config.yaml"
    vep_cache         = "${params.bioresources}/vep_cache"

    // Bases de Données Cliniques Horodatées
    clinvar           = "${params.bioresources}/clinical_databases/clinvar_15092026.vcf.gz"
    alphamissense     = "${params.bioresources}/clinical_databases/alphamissense_hg38_15092026.tsv.gz"
    revel             = "${params.bioresources}/clinical_databases/revel_hg38_v1.3_15092026.tsv.gz"

    // Dossier des 14 Conteneurs SIF Autonomes
    sif_dir           = "${params.bioresources}/sif"

    // Entrées / Sorties par défaut
    input             = "${params.bioresources}/samplesheets/SS_NS2000_latest.csv"
    outdir            = "results_WES_official"
}

profiles {
    // Profil 1 : Exécution locale Docker sur CHUNBIOTEST2
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) -v /NFS/cluster-share:/NFS/cluster-share -v /mnt/ngs_ns2000:/mnt/ngs_ns2000 -v /mnt/ngs_miseq:/mnt/ngs_miseq'

        process {
            withName: 'FALCO'                 { container = 'bishop/falco:1.2.5' }
            withName: 'FASTP'                 { container = 'bishop/fastp:0.23.4' }
            withName: 'BWAMEM2_ALIGN'         { container = 'bishop/bwamem2:2.2.1' }
            withName: 'MARKDUPLICATES'        { container = 'bishop/gatk:v4.4.0' }
            withName: 'BCFTOOLS_CONSENSUS'    { container = 'bishop/bcftools:1.18' }
            withName: 'MANTA'                 { container = 'bishop/manta:1.6.0' }
            withName: 'CNVKIT'                { container = 'bishop/cnvkit:0.9.10' }
            withName: 'CLINCNV'               { container = 'bishop/clincnv:1.19.1' }
            withName: 'DECON'                 { container = 'euformatics/decon:v1.4' }
            withName: 'DEEPVARIANT'           { container = 'bishop/deepvariant:1.6.0' }
            withName: 'GATK_HAPLOTYPECALLER'  { container = 'bishop/gatk:v4.4.0' }
            withName: 'FREEBAYES'             { container = 'bishop/freebayes:1.3.6' }
            withName: 'VEP'                   { container = 'bishop/vep:110.1' }
            withName: 'MOSDEPTH'              { container = 'bishop/mosdepth:0.3.5' }
            withName: 'MULTIQC'               { container = 'bishop/multiqc:1.21' }
        }
    }

    // Profil 2 : Soumission Cluster SLURM Optimisée Multi-Nœuds
    slurm {
        process.executor        = 'slurm'
        process.stageInMode     = 'symlink'
        process.beforeScript    = 'source ~/.bashrc'

        executor.queueSize      = 35
        executor.submitRateLimit= '10 sec'

        apptainer.enabled       = true
        apptainer.autoMounts    = true
        // Montage exhaustif des 3 disques vitaux du CHU de Nîmes
        apptainer.runOptions    = '-B /NFS/cluster-share:/NFS/cluster-share -B /mnt/ngs_ns2000:/mnt/ngs_ns2000 -B /mnt/ngs_miseq:/mnt/ngs_miseq'

        process {
            withName: 'FALCO'                 { container = "${params.sif_dir}/falco_1.2.5.sif" }
            withName: 'FASTP'                 { container = "${params.sif_dir}/fastp_0.23.4.sif" }
            withName: 'BWAMEM2_ALIGN'         { container = "${params.sif_dir}/bwamem2_2.2.1.sif" }
            withName: 'MARKDUPLICATES'        { container = "${params.sif_dir}/gatk_v4.4.0.sif" }
            withName: 'BCFTOOLS_CONSENSUS'    { container = "${params.sif_dir}/bcftools_1.18.sif" }
            withName: 'MANTA'                 { container = "${params.sif_dir}/manta_1.6.0.sif" }
            withName: 'CNVKIT'                { container = "${params.sif_dir}/cnvkit_0.9.10.sif" }
            withName: 'CLINCNV'               { container = "${params.sif_dir}/clincnv_1.19.1.sif" }
            withName: 'DECON'                 { container = "${params.sif_dir}/decon_1.4.sif" }
            withName: 'DEEPVARIANT'           { container = "${params.sif_dir}/deepvariant_1.6.0.sif" }
            withName: 'GATK_HAPLOTYPECALLER'  { container = "${params.sif_dir}/gatk_v4.4.0.sif" }
            withName: 'FREEBAYES'             { container = "${params.sif_dir}/freebayes_1.3.6.sif" }
            withName: 'VEP'                   { container = "${params.sif_dir}/vep_110.1.sif" }
            withName: 'MOSDEPTH'              { container = "${params.sif_dir}/mosdepth_0.3.5.sif" }
            withName: 'MULTIQC'               { container = "${params.sif_dir}/multiqc_1.21.sif" }
        }
    }
}

// -------------------------------------------------------------------------------------
// ALLOCATION DYNAMIQUE DES RESSOURCES ET DES FILES SLURM
// -------------------------------------------------------------------------------------
process {
    queue         = 'medium'
    cpus          = 4
    memory        = '16.GB'
    time          = '12.h'
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    // 1. Tâches légères (Exécutées sur node-2 et master)
    withName: 'FALCO|FASTP|MOSDEPTH|BCFTOOLS_CONSENSUS|MULTIQC' {
        queue  = 'short'
        cpus   = 2
        memory = '8.GB'
        time   = '2.h'
    }

    // 2. Callers intermédiaires (Répartis sur medium)
    withName: 'GATK_HAPLOTYPECALLER|FREEBAYES|CNVKIT|CLINCNV|DECON' {
        queue  = 'medium'
        cpus   = 4
        memory = '16.GB'
        time   = '8.h'
    }

    withName: 'MARKDUPLICATES|MANTA' {
        queue  = 'medium'
        cpus   = 6
        memory = '20.GB'
        time   = '6.h'
    }

    // 3. Processus lourds (Réservés à node-1 / CHUNBIOTEST2 via 'fat')
    withName: 'BWAMEM2_ALIGN' {
        queue  = 'fat'
        cpus   = 8
        memory = '32.GB'
        time   = '12.h'
    }

    withName: 'DEEPVARIANT' {
        queue  = 'fat'
        cpus   = 8
        memory = '32.GB'
        time   = '12.h'
    }

    withName: 'VEP' {
        queue  = 'fat'
        cpus   = 8
        memory = '24.GB'
        time   = '6.h'
    }
}

workflow.onComplete = {
    println "========================================================================"
    println "BiSHOP V2 — Bilan d'Exécution Clinique"
    println "Statut   : ${workflow.success ? 'SUCCÈS ' : 'ÉCHEC '}"
    println "Durée    : ${workflow.duration}"
    println "========================================================================"
}

cleanup = false
