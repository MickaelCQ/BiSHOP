/*
========================================================================================
    Pipeline Exome Constitutionnel Clinique - BiSHOP V2
    Config Multi-Profils : Docker (Local) & SLURM + Apptainer (Cluster)
========================================================================================
*/

params {
    // ---- Références Génomiques (Serveur CHU / NFS cluster-share) ----
    fasta             = "/NFS/cluster-share/projects/WES/hg38.fa"
    fasta_fai         = "/NFS/cluster-share/projects/WES/hg38.fa.fai"
    dict              = "/NFS/cluster-share/projects/WES/hg38.dict"
    bwa_index         = "/NFS/cluster-share/projects/WES/hg38.fa"

    // BED par défaut
    default_bed       = "/NFS/cluster-share/home/mcoquerelle/Explorations/bioresources/RefSeq_hg38_CDS_neutral_canonical.bed"

    // VEP & MultiQC
    multiqc_config    = "/NFS/cluster-share/home/mcoquerelle/Explorations/WES_Constit_ChoiceKit/multiqc_config.yaml"
    vep_cache         = "/NFS/cluster-share/home/mcoquerelle/Explorations/bioresources/vep_cache"

    // Dossier des conteneurs SIF pour SLURM
    sif_dir           = "/NFS/cluster-share/home/mcoquerelle/Explorations/singularity_cache"

    // Entrées / Sorties par défaut
    input             = "assets/samplesheet_toy_fastq.csv"
    outdir            = "results_toy_slurm_vep"
}

profiles {
    // Profil 1 : Exécution locale Docker sur CHUNBIOTEST2
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) -v /NFS/cluster-share:/NFS/cluster-share -v /mnt/ngs_ns2000:/mnt/ngs_ns2000'

        process {
            withName: 'FALCO'                 { container = 'bishop/falco:1.2.5' }
            withName: 'FASTP'                 { container = 'bishop/fastp:0.23.4' }
            withName: 'BWAMEM2_ALIGN'         { container = 'bishop/bwamem2:2.2.1' }
            withName: 'MARKDUPLICATES'        { container = 'bishop/gatk:v4.4.0' }
            withName: 'BCFTOOLS_CONSENSUS'    { container = 'bishop/bcftools:1.18' }
            withName: 'MANTA'                 { container = 'bishop/manta:1.6.0' }
            withName: 'CNVKIT'                { container = 'bishop/cnvkit:0.9.10' }
            withName: 'CLINCNV'               { container = 'bishop/clincnv:1.19.1' }
            withName: 'DECON'                 { container = 'euformatics/decon:v1.4' }
            withName: 'DEEPVARIANT'           { container = 'bishop/deepvariant:1.6.0' }
            withName: 'GATK_HAPLOTYPECALLER'  { container = 'bishop/gatk:v4.4.0' }
            withName: 'FREEBAYES'             { container = 'bishop/freebayes:1.3.6' }
            withName: 'VEP'                   { container = 'bishop/vep:110.1' }
            withName: 'MOSDEPTH'              { container = 'bishop/mosdepth:0.3.5' }
            withName: 'MULTIQC'               { container = 'bishop/multiqc:1.21' }
        }
    }

    // Profil 2 : Soumission Cluster SLURM via Apptainer
    slurm {
        process.executor     = 'slurm'
        process.queue        = 'fat'
        process.stageInMode  = 'symlink'
        process.beforeScript = 'source ~/.bashrc'

        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.runOptions = '-B /NFS/cluster-share:/NFS/cluster-share -B /mnt/ngs_ns2000:/mnt/ngs_ns2000'

        process {
            withName: 'FALCO'                 { container = "${params.sif_dir}/falco_1.2.5.sif" }
            withName: 'FASTP'                 { container = "${params.sif_dir}/fastp_0.23.4.sif" }
            withName: 'BWAMEM2_ALIGN'         { container = "${params.sif_dir}/bwamem2_2.2.1.sif" }
            withName: 'MARKDUPLICATES'        { container = "${params.sif_dir}/gatk_v4.4.0.sif" }
            withName: 'BCFTOOLS_CONSENSUS'    { container = "${params.sif_dir}/bcftools_1.18.sif" }
            withName: 'MANTA'                 { container = "${params.sif_dir}/manta_1.6.0.sif" }
            withName: 'CNVKIT'                { container = "${params.sif_dir}/cnvkit_0.9.10.sif" }
            withName: 'CLINCNV'               { container = "${params.sif_dir}/clincnv_1.19.1.sif" }
            withName: 'DECON'                 { container = "${params.sif_dir}/decon_1.4.sif" }
            withName: 'DEEPVARIANT'           { container = "${params.sif_dir}/deepvariant_1.6.0.sif" }
            withName: 'GATK_HAPLOTYPECALLER'  { container = "${params.sif_dir}/gatk_v4.4.0.sif" }
            withName: 'FREEBAYES'             { container = "${params.sif_dir}/freebayes_1.3.6.sif" }
            withName: 'VEP'                   { container = "${params.sif_dir}/vep_110.1.sif" }
            withName: 'MOSDEPTH'              { container = "${params.sif_dir}/mosdepth_0.3.5.sif" }
            withName: 'MULTIQC'               { container = "${params.sif_dir}/multiqc_1.21.sif" }
        }
    }
}

// Ressources par processus
process {
    cpus   = 4
    memory = '16.GB'
    time   = '4.h'

    withName: BWAMEM2_ALIGN {
        cpus   = 8
        memory = '32.GB'
    }
    withName: MARKDUPLICATES {
        cpus   = 4
        memory = '16.GB'
    }
    withName: MANTA {
        cpus   = 8
        memory = '16.GB'
    }
    withName: DEEPVARIANT {
        cpus   = 8	
        memory = '32.GB'
    }
    withName: GATK_HAPLOTYPECALLER {
        cpus   = 4
        memory = '16.GB'
    }
    withName: FREEBAYES {
        cpus   = 4
        memory = '16.GB'
    }
    withName: CLINCNV {
        cpus   = 4
        memory = '16.GB'
    }
    withName: DECON {
        cpus   = 4
        memory = '16.GB'
    }
    withName: VEP {
        cpus   = 8
        memory = '24.GB'
    }
}

workflow.onComplete = {
    println "========================================================================"
    println "BiSHOP V2 — Bilan d'Exécution Clinique"
    println "Statut   : ${workflow.success ? 'SUCCÈS ' : 'ÉCHEC '}"
    println "Durée    : ${workflow.duration}"
    println "========================================================================"
}

cleanup = false
